# MongoDB
MONGODB_URI=mongodb://localhost:27017/futureera

# JWT — generate your own random strings (at least 32 chars)
# Quick way: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Groq AI — get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (CORS) — don't change this for local dev
CLIENT_URL=http://localhost:5173

# Email (password reset) — configure for production
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@futureera.app
